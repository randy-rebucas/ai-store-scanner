// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model ShopSettings {
  id                     String   @id @default(cuid())
  shop                   String   @unique
  anthropicApiKey        String?
  aiModel                String   @default("claude-sonnet-5")
  slackWebhookUrl        String?
  adminNotificationEmail String?
  weeklyDigestEnabled    Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// Tracks whether a merchant marked a recommendation (identified by its exact
// title, which the AI keeps stable/short by design) as implemented or
// dismissed, so it isn't suggested again on future scans.
model RecommendationStatus {
  id        String   @id @default(cuid())
  shop      String
  title     String
  status    String // implemented | dismissed
  createdAt DateTime @default(now())

  @@unique([shop, title])
  @@index([shop])
}

model StoreScan {
  id              String    @id @default(cuid())
  shop            String
  status          String    @default("pending") // pending | running | completed | failed
  storeData       String? // JSON snapshot of collected store data
  recommendations String? // JSON array of recommended features
  errorMessage    String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([shop, createdAt])
}

model FeatureRequest {
  id          String   @id @default(cuid())
  shop        String
  scanId      String
  title       String
  description String
  impactLabel String
  status      String   @default("requested") // requested | in_progress | done
  createdAt   DateTime @default(now())

  @@unique([shop, scanId, title])
  @@index([shop, createdAt])
}

// Lightweight usage instrumentation for the AI build-prompt feature, so we
// can tell whether merchants actually view/copy/act on generated prompts
// rather than flying blind on adoption.
model PromptInteraction {
  id        String   @id @default(cuid())
  shop      String
  title     String
  action    String // viewed | copied | opened_builder
  createdAt DateTime @default(now())

  @@index([shop, createdAt])
  @@index([action])
}

// Audit trail of SEO auto-fixes applied to a merchant's products, so
// support/merchants can see exactly what the app changed and when.
model SeoFixLog {
  id                      String   @id @default(cuid())
  shop                    String
  productId               String
  productTitle            String
  previousSeoTitle        String?
  previousSeoDescription  String?
  newSeoTitle             String
  newSeoDescription       String
  appliedAt               DateTime @default(now())

  @@index([shop, appliedAt])
}
